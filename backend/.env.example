
# ─── Django ──────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-string-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Database ────────────────────────────────────────────────────────
# Leave unset for SQLite (local dev).  Set for PostgreSQL (Docker / prod).
# DATABASE_URL=postgres://postgres:postgres@db:5432/exam_engine

# ─── Redis ───────────────────────────────────────────────────────────
# Base URL — db 0 is used for Celery broker + result backend by default.
REDIS_URL=redis://localhost:6379/0

# Override per-concern if you need separate Redis instances:
# REDIS_CACHE_URL=redis://localhost:6379/1
# REDIS_SESSION_URL=redis://localhost:6379/2

# ─── Celery ──────────────────────────────────────────────────────────
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Set to True to run tasks synchronously (useful for debugging):
# CELERY_TASK_ALWAYS_EAGER=False

# ─── Flower (Celery monitoring) ──────────────────────────────────────
# FLOWER_PORT=5555

# ─── AI / External APIs ─────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_SUMMARY_MODEL=models/gemini-2.5-flash
# GEMINI_CLASSIFY_MODEL=models/gemini-2.0-flash

# ─── CORS & CSRF ────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Email (dev) ─────────────────────────────────────────────────────
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# ─── Auth / Frontend ─────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Flower Auth ────────────────────────────────────────────────────
FLOWER_USER=admin
FLOWER_PASSWORD=changeme_in_production
